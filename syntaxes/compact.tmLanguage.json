{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Compact",
	"patterns": [
		{
			"include": "#functions"
		},
		{
			"include": "#conditionals"
		},
		{
			"include": "#operations"
		},
		{
			"include": "#directives"
		},
		{
			"include": "#errors"
		},
		{
			"include": "#comments"
		}
	],
	"repository": {
		"functions": {
			"patterns": [{
				"match": "^ *(end|W|endW)$",
				"captures": {
					"1": {"name": "keyword.control.function.compact"}
				}
			}]
		},
		"conditionals": {
			"patterns": [{
				"match": "(?i)^ *(>|<|>=|<=|=) (-?\\d+\\.(e-?)?\\d*|-?\\.\\d+|\\d+) (-?\\d+\\.(e-?)?\\d*|-?\\.\\d+|\\d+)( (.*)  (.*)| (.*))?$",
				"captures": {
					"1": {
						"name": "keyword.operator.conditional.compact"
					},
					"2": {
						"patterns": [{"include": "#constants"}, {"include": "#decimals"}, {"include": "#variables"}]
					},
					"4": {
						"patterns": [{"include": "#constants"}, {"include": "#decimals"}, {"include": "#variables"}]
					},
					"7": {
						"name": "string.interpolated.input.compact"
					},
					"8": {
						"name": "string.interpolated.input.compact"
					},
					"9": {
						"name": "string.interpolated.input.compact"
					}
				}
			}]
		},
		"operations": {
			"patterns": [{
				"name": "meta.operation.compact",
				"match": "(?i)^ *(-?\\d+\\.(e-?)?\\d*|-?\\.\\d+|\\d+|i|-|&(\\d+((\\+|-)(\\d*.\\d+|\\d+))?)?) ((#-?)?\\d+)( (.*))?$",
				"captures": {
					"1": {
						"patterns": [{"include": "#lookups"}, {"include": "#constants"}, {"include": "#decimals"}, {"include": "#variables"}]
					},
					"7": {
						"patterns": [{"include": "#hash-variables"}, {"include": "#variables"}]
					},
					"10": {
						"name": "string.interpolated.input.compact"
					}
				}
			}]
		},
		"constants": {
			"patterns": [{
				"match": "(?i)(i|0+\\.?0*|-)",
				"name": "constant.language.compact"
			}]
		},
		"decimals": {
			"patterns": [{
				"match": "(-?\\d+\\.(e-?)?\\d*|-?\\.\\d+)",
				"name": "constant.numeric.compact"
			}]
		},
		"hash-variables": {
			"patterns": [{
				"match": "(#)(-?\\d+)",
				"captures": {
					"1": {
						"name": "keyword.operator.hash.compact"
					},
					"2": {
						"name": "constant.numeric.offset.compact"
					}
				}
			}]
		},
		"lookups": {
			"patterns": [{
				"match": "(&)((\\d+)((\\+|-)(\\d*.\\d+|\\d+))?)?",
				"captures": {
					"1": {
						"name": "keyword.operator.lookup.compact"
					},
					"3": {
						"name": "entity.name.lookup.compact"
					},
					"4": {
						"name": "constant.numeric.offset.compact"
					}
				}
			}]
		},
		"variables": {
			"patterns": [
				{"match": "([12]|10)$", "name": "support.variable.compact"},
				{"match": "[389]$", "name": "variable.language.compact"},
				{"match": "[4567]$", "name": "variable.other.compact"},
				{"match": ".+", "name": "variable.parameter.compact"}
			]
		},
		"directives": {
			"patterns": [{
				"match": "^ *(@(sounds)) (\\d+)$",
				"captures": {
					"1": {
						"name": "keyboard.control.directive.compact"
					},
					"3": {
						"name": "string.interpolated.directive.compact"
					}
				}
			}]
		},
		"errors": {
			"patterns": [{
				"match": "^ *((-?\\d+\\.(e-?)?\\d*|-?\\.\\d+|\\d+)|>|<|=|>=|<=|end|W|endW|i|@(sounds)|&.+) .+$",
				"name": "invalid.illegal.compact"
			}]
		},
		"comments": {
			"patterns": [{
				"match": "^.+$",
				"name": "comment.line.compact"
			}]
		}
	},
	"scopeName": "source.cpt"
}