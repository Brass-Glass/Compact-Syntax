{
  "name": "compact-syntax",
  "displayName": "Compact Syntax",
  "publisher": "-Brass_Glass-",
  "description": "Syntax-highlighting for Compact, the language.",
  "version": "3.0.0",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "contributes": {
    "languages": [{
      "id": "compact",
      "aliases": ["Compact", "compact"],
      "extensions": [".cpt",".compact"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "compact",
      "scopeName": "source.cpt",
      "path": "./syntaxes/compact.tmLanguage.json"
    }]
  },
  "icon": "./images/icon.png",
  "galleryBanner": {
    "color": "#3d2680",
    "theme": "dark"
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "homepage": "https://github.com/Brass-Glass/Compact-Syntax/blob/main/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/Brass-Glass/Compact-Syntax.git"
  }
}
